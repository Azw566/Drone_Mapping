          <geometry>
            <plane>
              <size>0.6 0.6</size>
            </plane>
          </geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
            <pbr>
              <metal>
                <albedo_map>file:///home/telemaque/ros_ws/drone/src/drone_bringup/models/aruco_marker/materials/textures/marker_2.png</albedo_map>
              </metal>
            </pbr>
          </material>
