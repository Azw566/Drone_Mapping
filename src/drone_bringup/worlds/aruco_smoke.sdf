            <pbr>
              <metal>
                <albedo_map>file:///home/telemaque/ros_ws/drone/src/drone_bringup/models/aruco_marker/materials/textures/marker_1.png</albedo_map>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>

      <link name="marker_2">
        <pose>0 0 1.2 0 -1.5708 0</pose>
